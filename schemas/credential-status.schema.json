{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trustlife.example/schemas/credential-status.schema.json",
  "title": "Trust & Life Demonstration Credential Status",
  "type": "object",
  "additionalProperties": false,
  "required": ["credentialId", "statusPurpose", "status", "sourceRegistry", "keyId", "updatedAt", "jws"],
  "properties": {
    "credentialId": {"type": "string", "minLength": 1},
    "statusPurpose": {"const": "revocation"},
    "status": {"enum": ["active", "suspended", "revoked"]},
    "sourceRegistry": {"type": "string", "pattern": "^tl:registry:"},
    "keyId": {"type": "string", "pattern": "^tl:key:"},
    "updatedAt": {"type": "string", "format": "date-time"},
    "jws": {"type": "string", "pattern": "^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$"}
  }
}

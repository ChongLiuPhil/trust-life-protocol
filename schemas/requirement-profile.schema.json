{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trustlife.example/schemas/requirement-profile.schema.json",
  "title": "Trust & Life Machine-readable Requirement Profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["profileSchemaVersion", "id", "version", "status", "title", "requirements", "publicationPolicy"],
  "properties": {
    "profileSchemaVersion": {"const": "0.4"},
    "id": {"type": "string", "pattern": "^TL-[A-Z0-9-]+$"},
    "version": {"type": "string"},
    "status": {"type": "string", "enum": ["draft", "pilot", "stable", "deprecated"]},
    "title": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "dependsOn": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "class", "method", "publicExplanation"],
        "properties": {
          "id": {"type": "string", "minLength": 3},
          "title": {"type": "string"},
          "class": {"type": "string", "enum": ["blocking", "advisory", "conditional"]},
          "method": {"type": "string", "enum": ["application-fields", "declarations", "claim", "incident-policy", "manual-review"]},
          "requiredFields": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "requiredDeclarationFields": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "claimRequirementIds": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "minimumLevel": {"type": "string", "enum": ["T0", "T1", "T2", "T3"]},
          "evidenceAnyOf": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "requiresIndependentVerification": {"type": "boolean"},
          "blockingSeverities": {"type": "array", "uniqueItems": true, "items": {"type": "string", "enum": ["informational", "low", "medium", "high", "critical"]}},
          "nonBlockingStates": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "sourceRequirements": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "publicExplanation": {"type": "string"}
        }
      }
    },
    "publicationPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["readyStates", "blockingFindingStates", "overallLevelRule", "forbidUniversalTrustScore"],
      "properties": {
        "readyStates": {"type": "array", "items": {"type": "string"}},
        "blockingFindingStates": {"type": "array", "items": {"type": "string"}},
        "overallLevelRule": {"type": "string"},
        "forbidUniversalTrustScore": {"type": "boolean"}
      }
    },
    "limitations": {"type": "array", "items": {"type": "string"}}
  }
}

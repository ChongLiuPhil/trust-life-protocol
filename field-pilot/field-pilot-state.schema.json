{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trustlife.example/field-pilot/field-pilot-state.schema.json",
  "title": "Trust & Life Field Pilot State",
  "type": "object",
  "additionalProperties": false,
  "required": ["pilotId", "profileId", "applicationId", "state", "updatedAt", "publicProjectionAllowed", "history"],
  "properties": {
    "pilotId": {"type": "string", "minLength": 1},
    "profileId": {"type": "string", "minLength": 1},
    "applicationId": {"type": "string", "minLength": 1},
    "state": {
      "enum": ["draft", "intake", "evidence-mapping", "preflight", "human-review", "approved", "live", "suspended", "corrective-action", "withdrawn", "completed"]
    },
    "updatedAt": {"type": "string", "format": "date-time"},
    "publicProjectionAllowed": {"type": "boolean"},
    "currentAssessmentDecision": {"enum": ["ready", "ready-with-advisories", "not-ready", "pending-human-review", "suspended", "withdrawn"]},
    "reason": {"type": "string"},
    "history": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["at", "state", "actorRole", "reason"],
        "properties": {
          "at": {"type": "string", "format": "date-time"},
          "state": {"type": "string"},
          "actorRole": {"enum": ["applicant", "pilot-operator", "evaluator", "qualified-verifier", "appeals-reviewer", "security-operator"]},
          "reason": {"type": "string", "minLength": 1},
          "assessmentId": {"type": "string"},
          "supersedesEventAt": {"type": "string", "format": "date-time"}
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"state": {"const": "live"}}},
      "then": {
        "properties": {
          "publicProjectionAllowed": {"const": true},
          "currentAssessmentDecision": {"enum": ["ready", "ready-with-advisories"]}
        }
      }
    },
    {
      "if": {"properties": {"state": {"enum": ["suspended", "withdrawn"]}}},
      "then": {"properties": {"publicProjectionAllowed": {"const": false}}}
    }
  ]
}
